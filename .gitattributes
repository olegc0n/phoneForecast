# Normalise text in the repository, check out with native endings on Windows.
* text=auto

# The APK toolchain and the phone both read these as text; keep them LF.
*.js   text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
*.java text eol=lf
*.xml  text eol=lf

# PowerShell wants CRLF on Windows.
*.ps1  text eol=crlf

*.jpg binary
*.png binary
*.apk binary
*.keystore binary
