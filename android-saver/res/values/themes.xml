<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework-only themes: no AppCompat, so the build needs no AndroidX jars. -->
    <!-- the setup screen: a plain dark settings-like page -->
    <style name="Saver" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <!-- the preview: the page and nothing else -->
    <style name="SaverFullscreen" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
