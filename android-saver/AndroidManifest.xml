<?xml version="1.0" encoding="utf-8"?>
<!-- Lili, the screen saver. A DreamService hosting assets/saver.html, a setup
     screen that explains how to switch it on, and a preview for phones whose
     maker removed the screen saver setting.

     No permissions at all: the page loads nothing it did not ship with.
     No version here: tools/build-saver-apk.ps1 injects android-saver/VERSION.
     `package` is the Java namespace; the installed application id is set by
     $AppId in tools/build-saver-apk.ps1, through aapt2's rename-manifest-package
     option, so the Java classes and R stay in com.lili.saver either way. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lili.saver">

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:theme="@style/Saver">

        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:theme="@style/SaverFullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <service
            android:name=".LiliDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:icon="@drawable/ic_launcher"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- SPIKE: Lili as a live wallpaper. See LiliWallpaper.java. -->
        <service
            android:name=".LiliWallpaper"
            android:exported="true"
            android:label="Lili wallpaper (test)"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
