# ---- generated by tools/build.js ----
# Every module in src/ is inlined into one self-contained page. Rebuild with:
#   node tools/build.js
/informer.html
/android/assets/informer.html
/tools/*.built.html

# ---- APK build output ----
/android/build/
*.apk

# ---- the real API key and coordinates ----
# The repository ships placeholders. Put your own in .local/config.json and the
# build picks them up; it is the only file in the project that holds a secret,
# and it never leaves this machine.
/.local/

# ---- signing material ----
# The debug keystore is a private key, and tools/build-apk.ps1 recreates it if
# it is missing. Note the consequence: a new keystore means a new signature, so
# `adb install -r` will refuse to update an app signed by the old one and the
# phone has to be uninstalled first. That loses localStorage - the weather cache
# and the day's plan - but nothing else.
/android/keystore/

# ---- editors and OS litter ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
