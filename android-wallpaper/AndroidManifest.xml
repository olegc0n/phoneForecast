<?xml version="1.0" encoding="utf-8"?>
<!-- Lili, the live wallpaper. A WallpaperService rendering assets/wallpaper.html
     onto the home screen, a still picture of her for the lock screen, a
     settings screen (also the launcher icon), a full-screen preview of
     settings not applied yet, with Apply, Cancel, the plan for the home and
     lock screens and an icons layer, the capture of the real home screen
     for that layer, and real weather for her clothes and scenes (Forecast,
     WeatherJob; never shown on screen).

     Permissions; the page itself still loads nothing it did not ship with (the
     WebView blocks network loads; only Java fetches the forecast):
       SET_WALLPAPER           putting a saved wallpaper (or My wallpaper) back,
                               and the lock-screen picture (setBitmap FLAG_LOCK).
                               Normal: no prompt.
       RECEIVE_BOOT_COMPLETED  the 3-hourly jobs are persisted across reboots: the
                               weather's (WeatherJob), and the lock picture's
                               (blocked in this version: only a picture left
                               from an earlier build is kept fresh)
       READ_EXTERNAL_STORAGE   reading the current wallpaper - to keep it as My
                               wallpaper, and to save it before Lili takes the
                               home screen. Asked for at run time, only where it
                               helps (API 23-32); Lili carries on without it.
       MANAGE_EXTERNAL_STORAGE "All files access": from Android 13 (API 33) the
                               only way an app may read the wallpaper, for My
                               wallpaper. The user grants it in the system
                               settings, from a card that says why; Lili reads
                               nothing else with it. (Play would reject this;
                               Lili is distributed through GitHub.)
       FOREGROUND_SERVICE      the capture service (API 28+). Normal.
       FOREGROUND_SERVICE_MEDIA_PROJECTION
                               ...of type mediaProjection (API 34+). Normal. The
                               capture itself is allowed by the user, each time,
                               in the system's screen-capture dialog.
       INTERNET                the forecast (Open-Meteo, MET Norway as the
                               fallback) and the city search, over HTTPS; only
                               with a place set and Real weather on. Normal.
       ACCESS_NETWORK_STATE    no attempt while offline. Normal.
       ACCESS_COARSE_LOCATION  "Use my location" only: asked at run time when
                               the user taps it; the network provider's fix.
                               Searching for a city needs nothing.
     No version here: tools/build-wallpaper-apk.ps1 injects android-wallpaper/VERSION.
     `package` is the Java namespace and equals $AppId in
     tools/build-wallpaper-apk.ps1 (tools/check-wallpaper.js asserts that).
     Not directBootAware: prefs, the photo and the WebView's data live in
     credential-protected storage, so Lili appears after the first unlock. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lili.wallpaper">

    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- implied by ACCESS_COARSE_LOCATION; not needed: a city can be searched for -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:theme="@style/Lili">

        <!-- not recreated on rotation: a backup, restore or dialog in flight
             stays with the screen that started it. The keyboard only when the
             city field is tapped. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/LiliSettings"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:theme="@style/LiliFullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- the home-screen capture: transparent, no UI, a task of its own (so the
             preview's task can go behind the launcher), not in recents; only
             the preview starts it -->
        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:theme="@style/LiliCapture"
            android:taskAffinity="com.lili.wallpaper.capture"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- the foreground service a MediaProjection needs (API 29+); only the
             capture starts it, for a second or two -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".LiliWallpaper"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- the lock-screen picture's 3-hourly refresh; only the system can bind it -->
        <service
            android:name=".LockJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <!-- the forecast's 3-hourly refresh, with any network; only the system can bind it -->
        <service
            android:name=".WeatherJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
    </application>
</manifest>
