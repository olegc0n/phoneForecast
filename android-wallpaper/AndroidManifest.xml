<?xml version="1.0" encoding="utf-8"?>
<!-- Lili, the live wallpaper. A WallpaperService rendering assets/wallpaper.html
     onto the home screen, a still picture of her for the lock screen, a
     settings screen (also the launcher icon) and a full-screen preview of
     settings not applied yet, with Apply and Cancel.

     Permissions, all for the user's previous wallpapers and the lock-screen
     picture (blocked in this version: nothing turns it on, but a picture left
     from an earlier build is kept fresh until it is turned off); the page
     itself still loads nothing it did not ship with:
       SET_WALLPAPER           putting a saved wallpaper back, and the lock-screen
                               picture (setBitmap FLAG_LOCK). Normal: no prompt.
       RECEIVE_BOOT_COMPLETED  the lock picture's 3-hourly refresh job is persisted
                               across reboots
       READ_EXTERNAL_STORAGE   reading the current wallpapers to save them, before
                               Lili takes the home screen. Asked for at run time,
                               only where it helps (API 23-32); Lili carries on
                               without it.
     No version here: tools/build-wallpaper-apk.ps1 injects android-wallpaper/VERSION.
     `package` is the Java namespace and equals $AppId in
     tools/build-wallpaper-apk.ps1 (tools/check-wallpaper.js asserts that).
     Not directBootAware: prefs, the photo and the WebView's data live in
     credential-protected storage, so Lili appears after the first unlock. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lili.wallpaper">

    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:theme="@style/Lili">

        <!-- not recreated on rotation: a switch's backup, restore or dialog in
             flight stays with the screen that started it -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/LiliSettings"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:theme="@style/LiliFullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <service
            android:name=".LiliWallpaper"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- the lock-screen picture's 3-hourly refresh; only the system can bind it -->
        <service
            android:name=".LockJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
    </application>
</manifest>
